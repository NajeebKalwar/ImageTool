---
import { siteConfig } from '../site.config';

interface Props {
  /** Page title shown in the browser tab and search results. */
  title: string;
  /** Page-specific summary for search results. */
  description: string;
  /** Root-relative canonical path, e.g. "/" or "/background-remover". */
  path: string;
  /** Optional page-level exclusion. Cannot override a non-production build. */
  noindex?: boolean;
}

const { title, description, path, noindex = false } = Astro.props;

// Fail closed: only a deployment explicitly marked as production can be indexed.
// Set SITE_ENV=production in the production build environment.
const isProduction = import.meta.env.SITE_ENV === 'production';
const shouldNoindex = !isProduction || noindex;

if (!path.startsWith('/') || path.startsWith('//') || path.includes('?') || path.includes('#')) {
  throw new Error(`Layout path must be a root-relative pathname without query or hash: ${path}`);
}

// Keep canonical URLs consistent with trailingSlash: 'never'.
// The home page remains "/"; other paths have no trailing slash.
const canonicalPath = path === '/' ? '/' : path.replace(/\/+$/, '');
const canonicalUrl = new URL(canonicalPath, Astro.site);
const robots = shouldNoindex ? 'noindex, nofollow' : 'index, follow';
---

<!doctype html>
<html lang={siteConfig.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl.href} />
    <meta name="robots" content={robots} />
  </head>
  <body>
    <slot />
  </body>
</html>
