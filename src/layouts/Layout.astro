---
import '../styles/global.css';
import { siteConfig } from '../site.config';

interface Props {
  /** Page-specific title without the site name suffix. */
  title: string;
  /** Page-specific summary for search results. */
  description: string;
  /** Root-relative canonical path, e.g. "/" or "/background-remover". */
  path: string;
  /** Exclude this page from indexing in production. */
  noindex?: boolean;
}

const { title, description, path, noindex = false } = Astro.props;

const pageTitle = title.trim();
const pageDescription = description.trim();

if (!pageTitle) {
  throw new Error('Layout title must not be empty.');
}

if (!pageDescription) {
  throw new Error('Layout description must not be empty.');
}

if (!path.startsWith('/') || path.startsWith('//') || path.includes('?') || path.includes('#')) {
  throw new Error(`Layout path must be a root-relative pathname without query or hash: ${path}`);
}

// The layout owns the site-name suffix. Page authors provide only the page title.
const fullTitle = `${pageTitle} | ${siteConfig.name}`;

if (!Astro.site) {
  throw new Error('Set site in astro.config.mjs so canonical URLs can be absolute.');
}

// Fail closed: only a deployment explicitly marked as production can be indexed.
// Set SITE_ENV=production in the production build environment.
const isProduction = import.meta.env.SITE_ENV === 'production';

// A page-level noindex can make a production page stricter, but cannot
// override the non-production safety policy.
const robots = !isProduction
  ? 'noindex, nofollow'
  : noindex
    ? 'noindex, follow'
    : 'index, follow';

// Keep canonical URLs consistent with trailingSlash: 'never'.
// The home page remains "/"; other paths have no trailing slash.
const canonicalPath = path === '/' ? '/' : path.replace(/\/+$/, '');
const canonicalUrl = new URL(canonicalPath, Astro.site);
---

<!doctype html>
<html lang={siteConfig.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl.href} />
    <meta name="robots" content={robots} />
  </head>
  <body>
    <slot />
  </body>
</html>
