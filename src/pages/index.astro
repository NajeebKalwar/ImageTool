---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../site.config';

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteConfig.name,
  url: Astro.site ? new URL('/', Astro.site).href : 'https://imagetool.example',
  description: 'Resize, compress, convert, enhance, and upscale images with privacy-first tools that process your images directly in your browser.',
};
---

<Layout
  title="Free Online Image Tools"
  description="Resize, compress, convert, enhance, and upscale images with privacy-first tools that process your images directly in your browser."
  path="/"
  jsonLd={websiteSchema}
>
  <main id="main-content" class="max-w-5xl mx-auto px-4 py-12 space-y-12">
    <header class="text-center mb-10">
      <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-100 tracking-tight mb-4">
        ImageTool
      </h1>
      <p class="text-lg text-slate-400 max-w-2xl mx-auto">
        Fast, browser-native image tools designed for absolute privacy.
        All processing, file conversions, and AI neural models run locally on your device.
      </p>
    </header>

    {/* Section 1: AI Neural Processing Tools */}
    <div class="space-y-4">
      <div class="flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-400" />
        <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-300">
          On-Device AI Neural Tools (WebGPU / WASM)
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {/* Background Remover Card */}
        <a
          href="/background-remover"
          class="group block p-6 bg-slate-900 hover:bg-slate-800/80 rounded-xl border border-slate-800 hover:border-emerald-500/50 transition-all shadow-lg hover:shadow-emerald-500/10"
        >
          <div class="w-10 h-10 mb-4 bg-emerald-950/80 border border-emerald-700/60 rounded-lg flex items-center justify-center text-emerald-400 group-hover:scale-110 transition-transform">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
          </div>
          <div class="flex items-center gap-2 mb-2">
            <h3 class="text-xl font-bold text-slate-100 group-hover:text-emerald-300 transition-colors">
              AI Background Remover
            </h3>
            <span class="text-[10px] px-1.5 py-0.5 rounded bg-emerald-950 border border-emerald-800 text-emerald-400 font-semibold uppercase">
              WebGPU AI
            </span>
          </div>
          <p class="text-sm text-slate-400 leading-relaxed">
            Remove backgrounds with on-device neural networks (BiRefNet-lite &amp; MODNet). Clean hair segmentation with zero cloud uploads.
          </p>
          <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-400 mt-4 group-hover:translate-x-1 transition-transform">
            Open Background Remover &rarr;
          </span>
        </a>

        {/* AI Image Upscaler Card */}
        <a
          href="/image-upscaler"
          class="group block p-6 bg-slate-900 hover:bg-slate-800/80 rounded-xl border border-slate-800 hover:border-purple-500/50 transition-all shadow-lg hover:shadow-purple-500/10"
        >
          <div class="w-10 h-10 mb-4 bg-purple-950/80 border border-purple-700/60 rounded-lg flex items-center justify-center text-purple-400 group-hover:scale-110 transition-transform">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <div class="flex items-center gap-2 mb-2">
            <h3 class="text-xl font-bold text-slate-100 group-hover:text-purple-300 transition-colors">
              AI Image Upscaler
            </h3>
            <span class="text-[10px] px-1.5 py-0.5 rounded bg-purple-950 border border-purple-800 text-purple-400 font-semibold uppercase">
              Tiled AI
            </span>
          </div>
          <p class="text-sm text-slate-400 leading-relaxed">
            Enlarge images 2x or 4x with zero-seam tiled super-resolution (Swin2SR &amp; Real-ESRGAN). 100% on-device inference.
          </p>
          <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-purple-400 mt-4 group-hover:translate-x-1 transition-transform">
            Open Upscaler Tool &rarr;
          </span>
        </a>

        {/* AI Image Workflow Studio Card */}
        <a
          href="/image-workflow"
          class="group block p-6 bg-slate-900 hover:bg-slate-800/80 rounded-xl border border-slate-800 hover:border-indigo-500/50 transition-all shadow-lg hover:shadow-indigo-500/10"
        >
          <div class="w-10 h-10 mb-4 bg-indigo-950/80 border border-indigo-700/60 rounded-lg flex items-center justify-center text-indigo-400 group-hover:scale-110 transition-transform">
            <span class="text-xl">🦜️🔗</span>
          </div>
          <div class="flex items-center gap-2 mb-2">
            <h3 class="text-xl font-bold text-slate-100 group-hover:text-indigo-300 transition-colors">
              AI Workflow Studio
            </h3>
            <span class="text-[10px] px-1.5 py-0.5 rounded bg-indigo-950 border border-indigo-800 text-indigo-400 font-semibold uppercase">
              LangChain
            </span>
          </div>
          <p class="text-sm text-slate-400 leading-relaxed">
            Automate compound workflows: cutout + studio padding + super-resolution + WebP compression in turnkey recipes.
          </p>
          <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-indigo-400 mt-4 group-hover:translate-x-1 transition-transform">
            Open Workflow Studio &rarr;
          </span>
        </a>
      </div>
    </div>

    {/* Section 2: Canvas & Optimization Tools */}
    <div class="space-y-4">
      <div class="flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-indigo-400" />
        <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-300">
          Client-Side Optimization Tools (Web Worker)
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {/* Image Compressor Card */}
        <a
          href="/image-compressor"
          class="group block p-6 bg-slate-900 hover:bg-slate-800/80 rounded-xl border border-slate-800 hover:border-emerald-500/50 transition-all shadow-lg hover:shadow-emerald-500/10"
        >
          <div class="w-10 h-10 mb-4 bg-emerald-950/80 border border-emerald-700/60 rounded-lg flex items-center justify-center text-emerald-400 group-hover:scale-110 transition-transform">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
            </svg>
          </div>
          <div class="flex items-center gap-2 mb-2">
            <h3 class="text-lg font-bold text-slate-100 group-hover:text-emerald-300 transition-colors">
              Image Compressor
            </h3>
            <span class="text-[10px] px-1.5 py-0.5 rounded bg-emerald-950 border border-emerald-800 text-emerald-400 font-semibold uppercase">
              Worker
            </span>
          </div>
          <p class="text-sm text-slate-400 leading-relaxed">
            Shrink image file size up to 85% with visually lossless WebP and JPEG compression. Zero quality loss.
          </p>
          <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-400 mt-4 group-hover:translate-x-1 transition-transform">
            Open Compressor &rarr;
          </span>
        </a>

        {/* WebP Converter Card */}
        <a
          href="/webp-converter"
          class="group block p-6 bg-slate-900 hover:bg-slate-800/80 rounded-xl border border-slate-800 hover:border-indigo-500/50 transition-all shadow-lg hover:shadow-indigo-500/10"
        >
          <div class="w-10 h-10 mb-4 bg-indigo-950/80 border border-indigo-700/60 rounded-lg flex items-center justify-center text-indigo-400 group-hover:scale-110 transition-transform">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
            </svg>
          </div>
          <div class="flex items-center gap-2 mb-2">
            <h3 class="text-lg font-bold text-slate-100 group-hover:text-indigo-300 transition-colors">
              WebP Converter
            </h3>
            <span class="text-[10px] px-1.5 py-0.5 rounded bg-indigo-950 border border-indigo-800 text-indigo-400 font-semibold uppercase">
              Batch
            </span>
          </div>
          <p class="text-sm text-slate-400 leading-relaxed">
            Batch convert PNG and JPEG photos to WebP, or convert WebP back to PNG and JPEG with one click.
          </p>
          <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-indigo-400 mt-4 group-hover:translate-x-1 transition-transform">
            Open WebP Converter &rarr;
          </span>
        </a>

        {/* Image Resizer Card */}
        <a
          href="/image-resizer"
          class="group block p-6 bg-slate-900 hover:bg-slate-800/80 rounded-xl border border-slate-800 hover:border-indigo-500/50 transition-all shadow-lg hover:shadow-indigo-500/10"
        >
          <div class="w-10 h-10 mb-4 bg-indigo-950/80 border border-indigo-700/60 rounded-lg flex items-center justify-center text-indigo-400 group-hover:scale-110 transition-transform">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" />
            </svg>
          </div>
          <div class="flex items-center gap-2 mb-2">
            <h3 class="text-lg font-bold text-slate-100 group-hover:text-indigo-300 transition-colors">
              Image Resizer &amp; Dimensions
            </h3>
            <span class="text-[10px] px-1.5 py-0.5 rounded bg-indigo-950 border border-indigo-800 text-indigo-400 font-semibold uppercase">
              Worker
            </span>
          </div>
          <p class="text-sm text-slate-400 leading-relaxed">
            Scale pixel dimensions, preserve aspect ratios, adjust compression quality, and convert formats.
          </p>
          <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-indigo-400 mt-4 group-hover:translate-x-1 transition-transform">
            Open Resizer Tool &rarr;
          </span>
        </a>
      </div>
    </div>

    {/* Privacy Guarantee Section */}
    <div class="p-6 bg-slate-950/60 rounded-xl border border-slate-800/80">
      <div class="flex items-start gap-4">
        <div class="w-10 h-10 shrink-0 bg-emerald-950/80 border border-emerald-700/60 rounded-lg flex items-center justify-center text-emerald-400">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
        </div>
        <div>
          <h3 class="text-lg font-bold text-slate-100 mb-1">
            Privacy Architecture Guarantee (P-01 to P-04)
          </h3>
          <p class="text-sm text-slate-400 leading-relaxed">
            Your images are processed entirely inside background Web Workers and on-device WebGPU/WASM neural runtimes. No image data or pixel buffers are ever uploaded or processed on external cloud servers.
          </p>
        </div>
      </div>
    </div>
  </main>
</Layout>
