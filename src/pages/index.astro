---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../site.config';

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteConfig.name,
  url: Astro.site ? new URL('/', Astro.site).href : 'https://imagetool.example',
  description: 'Resize, compress, convert, enhance, and upscale images with privacy-first tools that process your images directly in your browser.',
};
---

<Layout
  title="Free Online Image Tools"
  description="Resize, compress, convert, enhance, and upscale images with privacy-first tools that process your images directly in your browser."
  path="/"
  jsonLd={websiteSchema}
>
  <main id="main-content" class="max-w-5xl mx-auto px-4 sm:px-6 py-12 sm:py-16 space-y-20">
    {/* Centered Hero */}
    <header class="text-center max-w-2xl mx-auto space-y-4">
      <h1 class="text-4xl sm:text-5xl font-bold text-slate-900 tracking-tight">
        Private Browser Image Tools
      </h1>
      <p class="text-base sm:text-lg text-slate-600 leading-relaxed">
        Remove backgrounds, upscale photos, resize, and convert formats instantly in your browser.
        100% client-side processing with zero server uploads.
      </p>
      <div class="pt-2 flex flex-wrap items-center justify-center gap-3">
        <a
          href="/background-remover"
          class="px-5 py-2.5 rounded-lg bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold transition-colors shadow-xs"
        >
          Open Background Remover
        </a>
        <a
          href="/webp-converter"
          class="px-5 py-2.5 rounded-lg bg-white border border-blue-200 hover:border-blue-500 text-slate-800 hover:text-blue-600 text-sm font-semibold transition-colors"
        >
          Open Image Converter
        </a>
      </div>
    </header>

    {/* Section 1: All Tools */}
    <section id="all-tools" class="space-y-10">
      {/* AI Neural Tools */}
      <div class="space-y-4">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-blue-600" />
          <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-500">
            On-Device AI Neural Tools (WebGPU / WASM)
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
          {/* Background Remover Card */}
          <a
            href="/background-remover"
            class="group block p-6 bg-[#f8f9fc] hover:bg-white rounded-xl border border-slate-200/90 hover:border-blue-400 transition-all shadow-2xs hover:shadow-md"
          >
            <div class="w-9 h-9 mb-4 bg-blue-600 rounded-lg flex items-center justify-center text-white group-hover:scale-105 transition-transform">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
              </svg>
            </div>
            <div class="flex items-center gap-2 mb-2">
              <h3 class="text-lg font-bold text-slate-900 group-hover:text-blue-600 transition-colors">
                AI Background Remover
              </h3>
              <span class="text-[10px] px-1.5 py-0.5 rounded bg-blue-50 border border-blue-200 text-blue-700 font-semibold uppercase">
                WebGPU AI
              </span>
            </div>
            <p class="text-xs text-slate-600 leading-relaxed">
              Cut out objects, architecture, products, and portraits using BiRefNet-lite &amp; MODNet with zero cloud uploads.
            </p>
            <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-blue-600 mt-4 group-hover:translate-x-1 transition-transform">
              Open Background Remover &rarr;
            </span>
          </a>

          {/* AI Image Upscaler Card */}
          <a
            href="/image-upscaler"
            class="group block p-6 bg-[#f8f9fc] hover:bg-white rounded-xl border border-slate-200/90 hover:border-blue-400 transition-all shadow-2xs hover:shadow-md"
          >
            <div class="w-9 h-9 mb-4 bg-blue-600 rounded-lg flex items-center justify-center text-white group-hover:scale-105 transition-transform">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <div class="flex items-center gap-2 mb-2">
              <h3 class="text-lg font-bold text-slate-900 group-hover:text-blue-600 transition-colors">
                AI Image Upscaler
              </h3>
              <span class="text-[10px] px-1.5 py-0.5 rounded bg-blue-50 border border-blue-200 text-blue-700 font-semibold uppercase">
                Tiled AI
              </span>
            </div>
            <p class="text-xs text-slate-600 leading-relaxed">
              Enlarge images 2x or 4x with zero-seam tiled super-resolution (Swin2SR). 100% on-device inference.
            </p>
            <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-blue-600 mt-4 group-hover:translate-x-1 transition-transform">
              Open Upscaler Tool &rarr;
            </span>
          </a>

          {/* AI Image Workflow Studio Card */}
          <a
            href="/image-workflow"
            class="group block p-6 bg-[#f8f9fc] hover:bg-white rounded-xl border border-slate-200/90 hover:border-blue-400 transition-all shadow-2xs hover:shadow-md"
          >
            <div class="w-9 h-9 mb-4 bg-blue-600 rounded-lg flex items-center justify-center text-white group-hover:scale-105 transition-transform">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
              </svg>
            </div>
            <div class="flex items-center gap-2 mb-2">
              <h3 class="text-lg font-bold text-slate-900 group-hover:text-blue-600 transition-colors">
                AI Workflow Studio
              </h3>
              <span class="text-[10px] px-1.5 py-0.5 rounded bg-blue-50 border border-blue-200 text-blue-700 font-semibold uppercase">
                LangChain
              </span>
            </div>
            <p class="text-xs text-slate-600 leading-relaxed">
              Automate compound workflows: cutout + studio padding + super-resolution + WebP compression in turnkey recipes.
            </p>
            <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-blue-600 mt-4 group-hover:translate-x-1 transition-transform">
              Open Workflow Studio &rarr;
            </span>
          </a>
        </div>
      </div>

      {/* Optimization Tools */}
      <div class="space-y-4">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-blue-600" />
          <h2 class="text-xs font-semibold uppercase tracking-wider text-slate-500">
            Client-Side Optimization Tools (Web Worker)
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
          {/* Image Compressor Card */}
          <a
            href="/image-compressor"
            class="group block p-6 bg-[#f8f9fc] hover:bg-white rounded-xl border border-slate-200/90 hover:border-blue-400 transition-all shadow-2xs hover:shadow-md"
          >
            <div class="w-9 h-9 mb-4 bg-blue-600 rounded-lg flex items-center justify-center text-white group-hover:scale-105 transition-transform">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
              </svg>
            </div>
            <div class="flex items-center gap-2 mb-2">
              <h3 class="text-lg font-bold text-slate-900 group-hover:text-blue-600 transition-colors">
                Image Compressor
              </h3>
              <span class="text-[10px] px-1.5 py-0.5 rounded bg-slate-100 border border-slate-200 text-slate-600 font-semibold uppercase">
                Worker
              </span>
            </div>
            <p class="text-xs text-slate-600 leading-relaxed">
              Shrink image file size up to 85% with visually lossless WebP and JPEG compression. Zero quality loss.
            </p>
            <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-blue-600 mt-4 group-hover:translate-x-1 transition-transform">
              Open Compressor &rarr;
            </span>
          </a>

          {/* WebP Converter Card */}
          <a
            href="/webp-converter"
            class="group block p-6 bg-[#f8f9fc] hover:bg-white rounded-xl border border-slate-200/90 hover:border-blue-400 transition-all shadow-2xs hover:shadow-md"
          >
            <div class="w-9 h-9 mb-4 bg-blue-600 rounded-lg flex items-center justify-center text-white group-hover:scale-105 transition-transform">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
              </svg>
            </div>
            <div class="flex items-center gap-2 mb-2">
              <h3 class="text-lg font-bold text-slate-900 group-hover:text-blue-600 transition-colors">
                Image Converter
              </h3>
              <span class="text-[10px] px-1.5 py-0.5 rounded bg-slate-100 border border-slate-200 text-slate-600 font-semibold uppercase">
                Batch
              </span>
            </div>
            <p class="text-xs text-slate-600 leading-relaxed">
              Batch convert PNG and JPEG photos to WebP, or convert WebP back to PNG and JPEG with one click.
            </p>
            <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-blue-600 mt-4 group-hover:translate-x-1 transition-transform">
              Open Converter &rarr;
            </span>
          </a>

          {/* Image Resizer Card */}
          <a
            href="/image-resizer"
            class="group block p-6 bg-[#f8f9fc] hover:bg-white rounded-xl border border-slate-200/90 hover:border-blue-400 transition-all shadow-2xs hover:shadow-md"
          >
            <div class="w-9 h-9 mb-4 bg-blue-600 rounded-lg flex items-center justify-center text-white group-hover:scale-105 transition-transform">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" />
              </svg>
            </div>
            <div class="flex items-center gap-2 mb-2">
              <h3 class="text-lg font-bold text-slate-900 group-hover:text-blue-600 transition-colors">
                Image Resizer
              </h3>
              <span class="text-[10px] px-1.5 py-0.5 rounded bg-slate-100 border border-slate-200 text-slate-600 font-semibold uppercase">
                Worker
              </span>
            </div>
            <p class="text-xs text-slate-600 leading-relaxed">
              Scale pixel dimensions, preserve aspect ratios, adjust compression quality, and convert formats.
            </p>
            <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-blue-600 mt-4 group-hover:translate-x-1 transition-transform">
              Open Resizer Tool &rarr;
            </span>
          </a>
        </div>
      </div>
    </section>

    {/* How It Works Section */}
    <section id="how-it-works" class="space-y-8">
      <div class="text-center max-w-xl mx-auto space-y-2">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">
          How It Works
        </h2>
        <p class="text-sm text-slate-600">
          Process images instantly in your browser, no uploads, no tracking.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 max-w-4xl mx-auto">
        <div class="bg-[#f8f9fc] border border-slate-200/90 rounded-xl p-5 flex items-start gap-3.5 shadow-2xs">
          <span class="w-7 h-7 rounded-lg bg-blue-600 text-white text-xs font-bold flex items-center justify-center shrink-0 mt-0.5">
            1
          </span>
          <div>
            <h3 class="text-sm font-bold text-slate-900 mb-1">Upload your image</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              Drag and drop or browse to select your photo directly in the browser.
            </p>
          </div>
        </div>

        <div class="bg-[#f8f9fc] border border-slate-200/90 rounded-xl p-5 flex items-start gap-3.5 shadow-2xs">
          <span class="w-7 h-7 rounded-lg bg-blue-600 text-white text-xs font-bold flex items-center justify-center shrink-0 mt-0.5">
            2
          </span>
          <div>
            <h3 class="text-sm font-bold text-slate-900 mb-1">Pick tool &amp; settings</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              Choose AI cutout, upscaling, dimensions, or modern WebP formats.
            </p>
          </div>
        </div>

        <div class="bg-[#f8f9fc] border border-slate-200/90 rounded-xl p-5 flex items-start gap-3.5 shadow-2xs">
          <span class="w-7 h-7 rounded-lg bg-blue-600 text-white text-xs font-bold flex items-center justify-center shrink-0 mt-0.5">
            3
          </span>
          <div>
            <h3 class="text-sm font-bold text-slate-900 mb-1">Process and download</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              One click to run locally in Web Workers, one click to download.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* Our Features Section */}
    <section id="our-features" class="space-y-8">
      <div class="text-center max-w-xl mx-auto space-y-2">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">
          Our features
        </h2>
        <p class="text-sm text-slate-600">
          No uploads. No waiting. Just fast, private processing.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 max-w-2xl mx-auto">
        <div class="bg-[#f8f9fc] border border-slate-200/90 rounded-xl p-6 text-center shadow-2xs">
          <div class="w-9 h-9 rounded-lg bg-blue-600 text-white flex items-center justify-center mx-auto mb-3">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="text-sm font-bold text-slate-900 mb-1">Instant conversion</h3>
          <p class="text-xs text-slate-600">No server uploads.</p>
        </div>

        <div class="bg-[#f8f9fc] border border-slate-200/90 rounded-xl p-6 text-center shadow-2xs">
          <div class="w-9 h-9 rounded-lg bg-blue-600 text-white flex items-center justify-center mx-auto mb-3">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
          </div>
          <h3 class="text-sm font-bold text-slate-900 mb-1">Private and secure</h3>
          <p class="text-xs text-slate-600">Your files never leave your device.</p>
        </div>

        <div class="bg-[#f8f9fc] border border-slate-200/90 rounded-xl p-6 text-center shadow-2xs">
          <div class="w-9 h-9 rounded-lg bg-blue-600 text-white flex items-center justify-center mx-auto mb-3">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
            </svg>
          </div>
          <h3 class="text-sm font-bold text-slate-900 mb-1">Optimized for developers</h3>
          <p class="text-xs text-slate-600">Modern formats ready for production.</p>
        </div>

        <div class="bg-[#f8f9fc] border border-slate-200/90 rounded-xl p-6 text-center shadow-2xs">
          <div class="w-9 h-9 rounded-lg bg-blue-600 text-white flex items-center justify-center mx-auto mb-3">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
            </svg>
          </div>
          <h3 class="text-sm font-bold text-slate-900 mb-1">Simple, clean UI</h3>
          <p class="text-xs text-slate-600">Minimal steps, maximum efficiency.</p>
        </div>
      </div>
    </section>

    {/* Privacy Guarantee Banner */}
    <section class="max-w-4xl mx-auto p-6 bg-[#f8f9fc] rounded-xl border border-slate-200/90 shadow-2xs">
      <div class="flex items-start gap-4">
        <div class="w-10 h-10 shrink-0 bg-blue-600 rounded-lg flex items-center justify-center text-white">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
        </div>
        <div>
          <h3 class="text-base font-bold text-slate-900 mb-1">
            Privacy Architecture Guarantee (P-01 to P-04)
          </h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            Your images are processed entirely inside background Web Workers and on-device WebGPU/WASM neural runtimes. No image data or pixel buffers are ever uploaded or processed on external cloud servers.
          </p>
        </div>
      </div>
    </section>
  </main>
</Layout>
