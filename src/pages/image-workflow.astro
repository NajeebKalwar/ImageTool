---
import Layout from '../layouts/Layout.astro';
import ImageWorkflow from '../components/ImageWorkflow';
---

<Layout
  title="AI Image Workflow Studio - LangChain On-Device Recipes"
  description="Automate multi-step photo processing with compound on-device LangChain recipes: background removal, super-resolution, canvas padding, and WebP compression."
  path="/image-workflow"
>
  <main id="main-content" class="max-w-5xl mx-auto px-4 sm:px-6 py-10 sm:py-14">
    <header class="text-center max-w-2xl mx-auto mb-10 space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 border border-blue-200 text-xs font-semibold text-blue-700">
        <span>🦜️🔗 Powered by LangChain.js Core</span>
      </div>
      <h1 class="text-3xl sm:text-5xl font-bold text-slate-900 tracking-tight">
        AI Image Workflow Studio
      </h1>
      <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
        Execute compound image recipes with automated tool-calling pipelines.
        100% on-device execution with zero cloud uploads.
      </p>
    </header>

    <ImageWorkflow client:load />
  </main>
</Layout>
