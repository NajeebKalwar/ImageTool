---
import type { ToolDefinition } from '../content/schema';

interface Props {
  tool: ToolDefinition;
}

const { tool } = Astro.props;
---

<main id="main-content" class="max-w-5xl mx-auto px-4 sm:px-6 py-10 sm:py-14">
  {/* Tool Hero */}
  <header class="mb-10 text-center max-w-2xl mx-auto">
    <h1 class="text-3xl sm:text-5xl font-bold text-slate-900 tracking-tight mb-3">
      {tool.headline}
    </h1>
    <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
      {tool.tagline}
    </p>
  </header>

  {/* Interactive Tool Island Slot */}
  <slot />

  {/* Structured Content Matching Clean Light Theme */}
  <article class="mt-20 space-y-20 text-slate-700">
    {/* How It Works (3-Column Step Cards) */}
    {tool.steps.length > 0 && (
      <section id="how-it-works" class="space-y-8">
        <div class="text-center max-w-xl mx-auto space-y-2">
          <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">
            How It Works
          </h2>
          <p class="text-sm text-slate-600">
            {tool.stepsHeading || `Process images instantly in your browser, no uploads, no tracking.`}
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 max-w-4xl mx-auto">
          {tool.steps.map((step, index) => (
            <div class="bg-[#f8f9fc] border border-slate-200/90 rounded-xl p-5 flex items-start gap-3.5 shadow-2xs">
              <span class="w-7 h-7 rounded-lg bg-blue-600 text-white text-xs font-bold flex items-center justify-center shrink-0 mt-0.5">
                {index + 1}
              </span>
              <div class="min-w-0">
                <h3 class="text-sm font-bold text-slate-900 mb-1">
                  {step.title}
                </h3>
                <p class="text-xs text-slate-600 leading-relaxed">
                  {step.description}
                </p>
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    {/* Our Features (Centered Icon Cards) */}
    <section id="our-features" class="space-y-8">
      <div class="text-center max-w-xl mx-auto space-y-2">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">
          Our features
        </h2>
        <p class="text-sm text-slate-600">
          No uploads. No waiting. Just fast, private processing.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 max-w-2xl mx-auto">
        <div class="bg-[#f8f9fc] border border-slate-200/90 rounded-xl p-6 text-center shadow-2xs">
          <div class="w-9 h-9 rounded-lg bg-blue-600 text-white flex items-center justify-center mx-auto mb-3">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="text-sm font-bold text-slate-900 mb-1">Instant processing</h3>
          <p class="text-xs text-slate-600">No server uploads or remote queues.</p>
        </div>

        <div class="bg-[#f8f9fc] border border-slate-200/90 rounded-xl p-6 text-center shadow-2xs">
          <div class="w-9 h-9 rounded-lg bg-blue-600 text-white flex items-center justify-center mx-auto mb-3">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
          </div>
          <h3 class="text-sm font-bold text-slate-900 mb-1">Private and secure</h3>
          <p class="text-xs text-slate-600">Your files never leave your device.</p>
        </div>

        <div class="bg-[#f8f9fc] border border-slate-200/90 rounded-xl p-6 text-center shadow-2xs">
          <div class="w-9 h-9 rounded-lg bg-blue-600 text-white flex items-center justify-center mx-auto mb-3">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
            </svg>
          </div>
          <h3 class="text-sm font-bold text-slate-900 mb-1">Optimized for creators</h3>
          <p class="text-xs text-slate-600">Modern formats ready for production.</p>
        </div>

        <div class="bg-[#f8f9fc] border border-slate-200/90 rounded-xl p-6 text-center shadow-2xs">
          <div class="w-9 h-9 rounded-lg bg-blue-600 text-white flex items-center justify-center mx-auto mb-3">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
            </svg>
          </div>
          <h3 class="text-sm font-bold text-slate-900 mb-1">Simple, clean UI</h3>
          <p class="text-xs text-slate-600">Minimal steps, maximum efficiency.</p>
        </div>
      </div>
    </section>

    {/* Tool-Specific Highlights */}
    {tool.features.length > 0 && (
      <section class="max-w-4xl mx-auto space-y-6">
        <div class="text-center">
          <h2 class="text-xl font-bold text-slate-900">
            {tool.featuresHeading || 'Capabilities & Formats'}
          </h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
          {tool.features.map((feature) => (
            <div class="bg-[#f8f9fc] p-5 rounded-xl border border-slate-200/90 shadow-2xs">
              <h3 class="text-sm font-bold text-slate-900 mb-1.5">
                {feature.title}
              </h3>
              <p class="text-xs text-slate-600 leading-relaxed">
                {feature.description}
              </p>
            </div>
          ))}
        </div>
      </section>
    )}

    {/* Technical Architecture Summary */}
    <section class="max-w-4xl mx-auto bg-[#f8f9fc] p-6 sm:p-8 rounded-xl border border-slate-200/90 shadow-2xs space-y-3">
      <h2 class="text-lg font-bold text-slate-900">
        How Browser-Native Image Processing Works
      </h2>
      <p class="text-sm text-slate-600 leading-relaxed">
        {tool.howItWorks.summary}
      </p>
      <p class="text-sm text-slate-600 leading-relaxed">
        {tool.howItWorks.technicalDetails}
      </p>
      <p class="text-xs text-blue-700 bg-blue-50 border border-blue-200/80 rounded-lg px-3.5 py-2.5 font-medium">
        🛡️ {tool.howItWorks.privacyGuarantee}
      </p>
    </section>

    {/* Empirical Benchmarks */}
    {tool.benchmarks && (
      <section class="max-w-4xl mx-auto bg-[#f8f9fc] p-6 rounded-xl border border-slate-200/90 shadow-2xs space-y-4">
        <div>
          <h2 class="text-lg font-bold text-slate-900 mb-1">
            {tool.benchmarks.title}
          </h2>
          <p class="text-xs text-slate-600">
            {tool.benchmarks.description} • <span class="text-slate-500 font-mono">{tool.benchmarks.environment}</span>
          </p>
        </div>
        <div class="overflow-x-auto bg-white rounded-lg border border-slate-200">
          <table class="w-full text-left text-xs sm:text-sm text-slate-700">
            <thead class="bg-slate-50 text-slate-500 uppercase text-[11px] font-semibold border-b border-slate-200">
              <tr>
                <th class="py-2.5 px-3">Metric</th>
                <th class="py-2.5 px-3 text-blue-600">On-Device WebGPU</th>
                <th class="py-2.5 px-3 text-slate-700">On-Device WASM</th>
                <th class="py-2.5 px-3 text-slate-500">Cloud API (SaaS)</th>
                <th class="py-2.5 px-3 text-emerald-700">ImageTool Advantage</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-200/70">
              {tool.benchmarks.metrics.map((row) => (
                <tr class="hover:bg-slate-50/70">
                  <td class="py-2.5 px-3 font-medium text-slate-900">{row.label}</td>
                  <td class="py-2.5 px-3 font-semibold text-blue-600">{row.onDeviceWebGpu}</td>
                  <td class="py-2.5 px-3 text-slate-600">{row.onDeviceWasm}</td>
                  <td class="py-2.5 px-3 text-slate-500">{row.cloudService}</td>
                  <td class="py-2.5 px-3 font-medium text-emerald-700">{row.advantage}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )}

    {/* Frequently Asked Questions */}
    {tool.faqs.length > 0 && (
      <section class="max-w-4xl mx-auto border-t border-slate-200/80 pt-10">
        <h2 class="text-2xl font-bold text-slate-900 text-center mb-8">
          {tool.faqHeading || 'Frequently Asked Questions'}
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {tool.faqs.map((faq) => (
            <div class="bg-[#f8f9fc] border border-slate-200/90 rounded-xl p-5 shadow-2xs">
              <h3 class="text-sm font-bold text-slate-900 mb-1.5">
                {faq.question}
              </h3>
              <p class="text-xs text-slate-600 leading-relaxed">
                {faq.answer}
              </p>
            </div>
          ))}
        </div>
      </section>
    )}
  </article>
</main>
