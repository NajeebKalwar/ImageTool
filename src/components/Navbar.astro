---
import { siteConfig } from '../site.config';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const isHome = currentPath === '/';
const isToolPage = [
  '/background-remover',
  '/image-upscaler',
  '/image-workflow',
  '/image-compressor',
  '/webp-converter',
  '/image-resizer',
].includes(currentPath);
---

<header class="w-full border-b border-slate-200/70 bg-white/60 backdrop-blur-md sticky top-0 z-40">
  <nav
    aria-label="Primary Navigation"
    class="max-w-5xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-4"
  >
    {/* Brand Logo */}
    <a
      href="/"
      class="flex items-center gap-2 text-lg font-extrabold tracking-tight text-slate-900 hover:text-blue-600 transition-colors"
    >
      <span class="w-7 h-7 rounded-lg bg-blue-600 text-white flex items-center justify-center shadow-sm">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
      </span>
      <span>{siteConfig.name}</span>
    </a>

    {/* Center Nav Links */}
    <div class="hidden md:flex items-center gap-7 text-sm font-medium text-slate-600">
      <a
        href={isToolPage ? '#our-features' : isHome ? '#all-tools' : '/#all-tools'}
        class="hover:text-blue-600 transition-colors"
      >
        Our features
      </a>
      <a
        href={isToolPage ? '#how-it-works' : isHome ? '#how-it-works' : '/#how-it-works'}
        class="hover:text-blue-600 transition-colors"
      >
        How it works
      </a>
      <a
        href="/about"
        class={`hover:text-blue-600 transition-colors ${currentPath === '/about' ? 'text-blue-600 font-semibold' : ''}`}
      >
        About us
      </a>
    </div>

    {/* Right CTA Button */}
    <div class="flex items-center gap-2.5">
      <a
        href="/"
        class="md:hidden px-3 py-1.5 text-xs font-medium text-slate-700 hover:text-blue-600 transition-colors"
      >
        Tools
      </a>
      <a
        href="/contact"
        class="px-4 py-1.5 text-sm font-medium text-slate-800 bg-white border border-blue-200 hover:border-blue-500 hover:text-blue-600 rounded-lg transition-colors shadow-2xs"
      >
        Contact us
      </a>
    </div>
  </nav>
</header>
