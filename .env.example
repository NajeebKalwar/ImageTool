# Environment Configuration Template for ImageTool
# Copy to .env or configure in Cloudflare Pages / Workers settings.

# Environment Mode:
# 'production' emits index, follow and generates sitemap-index.xml.
# Any other value ('preview', 'development') emits noindex, nofollow and disables sitemap generation.
SITE_ENV=preview

# Cloudflare R2 Model Hosting:
# Custom domain pointing to the Cloudflare R2 bucket holding model weights and configs.
# Must include trailing slash.
# Example: https://models.imagetool.example/
# If unset or empty during development, Transformers.js automatically falls back to Hugging Face Hub (https://huggingface.co/).
PUBLIC_MODEL_HOST=https://models.imagetool.example/

# Cloudflare R2 WebAssembly Hosting:
# Custom domain path pointing to self-hosted ONNX Runtime Web WASM binaries.
# Example: https://models.imagetool.example/wasm/
PUBLIC_WASM_HOST=https://models.imagetool.example/wasm/

# Optional S3/R2 Credentials for scripts/sync-models.ts upload automation:
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_BUCKET_NAME=imagetool-models
